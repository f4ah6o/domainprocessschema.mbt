{
  "name": "domainprocessschema-mbt",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker deployment tooling for the domainprocessschema.mbt WASM demo",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:cloudflare-demo-assets": "node scripts/build-cloudflare-demo.mjs",
    "dev:worker": "cf dev",
    "deploy:worker": "cf deploy",
    "deploy:preview-worker": "cf deploy --mode preview",
    "test:js": "node --test wasm/demo/worker.test.mjs wasm/demo/webmcp.test.mjs"
  },
  "devDependencies": {
    "cf": "1.0.0-beta.14",
    "wrangler": "^4.149.0"
  }
}
